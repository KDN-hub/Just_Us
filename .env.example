NEXT_PUBLIC_SUPABASE_URL=https://your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── TURN relay for calling (optional but recommended) ────────────────────────
# Server-only secrets — intentionally NOT NEXT_PUBLIC_. The client fetches
# fresh ICE servers from GET /api/turn with the user's Bearer token, so TURN
# credentials are never inlined into the shipped JavaScript bundle.
# TURN services (e.g. Cloudflare Calls TURN, Twilio NTS) issue static shared
# credentials; rotation happens on the server without app updates.
TURN_URL=turn:your-turn-host:3478
TURN_USERNAME=your-turn-username
TURN_PASSWORD=your-turn-password
#
# General-purpose public STUN is always enabled as the fallback:
# stun:stun.l.google.com:19302 and stun:stun1.l.google.com:19302.
# Without TURN, calls succeed on most home/carrier NATs but can fail on
# restrictive corporate Wi-Fi or symmetric firewalls — see 011_* migration
# and the audit report for the full failure symptom list.
